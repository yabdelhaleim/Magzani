###############################################################################
# Magzani ERP — Production Environment Template
# -----------------------------------------------------------------------------
# ⚠️  هذا الملف هو نموذج (Template) يُنسخ إلى `.env` على السيرفر فقط.
# ⚠️  يجب استبدال كل القيم الفارغة بقيم حقيقية ومُولّدة بأمان.
# ⚠️  لا تنسخ هذا الملف إلى Git أو إلى staging يحوي الـ production secrets.
###############################################################################

APP_NAME=Magzani
APP_ENV=production
APP_DEBUG=false
# ⚠️ Required: a real HTTPS URL.
APP_URL=https://superdashboard.remotelly1.site
APP_KEY=base64:E94GRNOM8vEz1AI6MDCMQehdY9weJLi+diwWPGGQ8go=

# Comma-separated central (landlord) domains only.
# Includes the public pricing subdomain if you have one.
# ⚠️ Production-only domains — do NOT include localhost.
CENTRAL_DOMAINS=superdashboard.remotelly1.site,bakedgekayan.remotelly1.site
TENANT_DOMAIN_SUFFIX=remotelly1.site
TENANT_URL_SCHEME=https
TENANT_URL_PORT=

# Platform operator account (central dashboard). Set real values only in the server `.env`.
# SUPER_ADMIN_NAME="Platform Administrator"
# SUPER_ADMIN_EMAIL=admin@example.com
# SUPER_ADMIN_PASSWORD=replace-with-a-strong-password

# --- Public Pricing Page (Kayyan SaaS marketing site) ---
KAYYAN_DEMO_URL=https://remotelly1.site/
KAYYAN_SIGNUP_URL=https://kayan.remotelly1.site/login
KAYYAN_BRAND_NAME="كيان SaaS"
KAYYAN_BRAND_TAGLINE="نظام إدارة الأعمال والمخازن الذكي"
KAYYAN_SEO_TITLE="الأسعار | كيان SaaS - نظام إدارة الأعمال الذكي"
KAYYAN_SEO_DESCRIPTION="اختر باقة كيان SaaS المناسبة لنمو أعمالك. باقات مرنة تبدأ من 99 ريال شهرياً."
KAYYAN_SEO_KEYWORDS="نظام إدارة أعمال, نقاط بيع, محاسبة, تصنيع, مخازن, فواتير, كيان SaaS, Magzani, ERP, POS"

###############################################################################
# LOGGING (Fixed: warning instead of debug for production)
###############################################################################
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

###############################################################################
# DATABASE (Fixed: production-grade credentials)
# -----------------------------------------------------------------------------
# ⚠️  REQUIRED: Create a dedicated MySQL user with minimal privileges
#     (SELECT, INSERT, UPDATE, DELETE, CREATE, DROP, INDEX, ALTER, REFERENCES)
#     on the production database. Do NOT use root.
# ⚠️  REQUIRED: Use a strong password (min 32 chars, mixed case, numbers, symbols).
###############################################################################
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=magzany
DB_USERNAME=magzani_app
# ⚠️  REQUIRED: Set a strong password in .env on the server.
DB_PASSWORD=

###############################################################################
# CACHE / SESSION / QUEUE / BROADCAST (Production: Redis)
# -----------------------------------------------------------------------------
# ⚠️  RECOMMENDED: Use Redis for both cache and session.
# ⚠️  If Redis is not available, keep CACHE on file (acceptable) but never
#     use file driver for session in production (load balancer breaks state).
# ⚠️  Must create 'jobs' and 'failed_jobs' tables if using QUEUE_CONNECTION=database.
###############################################################################
BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Trust the load balancer/proxy IP so HTTPS detection works correctly.
# Adjust to specific IPs/CDN ranges in production for tighter security.
TRUSTED_PROXIES="*"

# Optional: explicit allow-list of trusted hostnames (comma-separated).
# Use this only if you have hosts NOT covered by TENANT_DOMAIN_SUFFIX or
# CENTRAL_DOMAINS. Examples: cdn.example.com, admin.example.com.
# TRUSTED_HOSTS=cdn.example.com,admin.example.com

# Session cookie security (HTTPS-only — REQUIRED in production)
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Sanctum stateful domains (for SPA / cross-origin auth)
SANCTUM_STATEFUL_DOMAINS="kayan.remotelly1.site,superdashboard.remotelly1.site"

###############################################################################
# REDIS
###############################################################################
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

###############################################################################
# MAIL
###############################################################################
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=notifications@example.com
# ⚠️  Set the real password in .env on the server.
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

###############################################################################
# AWS S3 (Object Storage — backups, file uploads)
###############################################################################
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=magzani-backups
AWS_USE_PATH_STYLE_ENDPOINT=false

###############################################################################
# BACKUP CONFIGURATION (Spatie Laravel Backup)
# -----------------------------------------------------------------------------
# These vars are read by config/backup.php once published.
###############################################################################
BACKUP_DISK=s3
BACKUP_DISKS=s3
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICATION_EMAIL=ops@example.com
BACKUP_SLACK_WEBHOOK_URL=
BACKUP_DAILY_AT=03:30
BACKUP_TIMEOUT_SECONDS=3600
BACKUP_MAX_AGE_DAYS=1
BACKUP_MAX_SIZE_MB=5000
# Optional: set to false to skip per-tenant DB dumping.
BACKUP_DAILY_TENANTS=true
BACKUP_TENANT_KEEP=7
# Set to e.g. "mail" if you want success notifications. Default: no success mails.
BACKUP_MAIL_ON_SUCCESS=

###############################################################################
# REALTIME (Reverb)
###############################################################################
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=ws.example.com
REVERB_PORT=443
REVERB_SCHEME=https

###############################################################################
# PUSHER (broadcasting fallback)
###############################################################################
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_HOST="${PUSHER_HOST}"
VITE_PUSHER_APP_PORT="${PUSHER_PORT}"
VITE_PUSHER_APP_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

###############################################################################
# CORS (Production: explicit allow-list)
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins. Never use `*` with credentials.
# Add new tenant domains here as you onboard them.
CORS_ALLOWED_ORIGINS=https://kayan.remotelly1.site,https://superdashboard.remotelly1.site,https://bakedgekayan.remotelly1.site
# Optional regex patterns (comma-separated). Use sparingly.
# CORS_ALLOWED_ORIGINS_PATTERNS=^https://.*\.remotelly1\.site$
CORS_MAX_AGE=86400
CORS_SUPPORTS_CREDENTIALS=true
